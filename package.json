    "db:mysql:push": "prisma db push --schema database/prisma/schema.mysql.prisma",
    "db:mysql:studio": "prisma studio --schema database/prisma/schema.mysql.prisma",
    "db:mysql:seed": "node database/seed.mysql.mjs"
