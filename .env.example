# Local MySQL option for end-to-end local database testing.
# Use this with database/prisma/schema.mysql.prisma and the db:mysql:* commands.
DATABASE_URL_MYSQL="mysql://grammarforge:grammarforge_password@localhost:3306/grammarforge"

# Supabase, Neon, or another free-tier PostgreSQL connection string.
# For Supabase pooled/serverless connections, use the pooler URL for DATABASE_URL.
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# Direct connection is useful for Prisma migrations on Supabase/Neon.
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional secret for scheduled jobs.
# Call /api/cron/question-generation?secret=... locally, or set this in Vercel.
CRON_SECRET="replace-with-a-cron-secret"

# Optional zero-cost AI/cache providers. The app has local fallbacks when these are absent.
# Configure both Gemini and Groq so the admin panel can switch priority and the runtime can fail over on quota/API failures.
GEMINI_API_KEY=""
GROQ_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Stripe billing. Leave blank for demo mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_FOUNDATION_PRICE_ID=""
STRIPE_ALPHA_PRICE_ID=""
STRIPE_VELOCITY_PRICE_ID=""
STRIPE_APEX_PRICE_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production email verification.
# Preferred: Brevo transactional API key.
BREVO_API_KEY=""
EMAIL_FROM="GrammarForge <no-reply@yourdomain.com>"
APP_URL="http://localhost:3000"

# Optional SMTP fallback if you do not use BREVO_API_KEY.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
